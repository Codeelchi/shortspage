---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
}

const { title, description, canonicalPath } = Astro.props;
const base = '/shortspage/brightbean';
const canonical = `https://codeelchi.github.io${base}${canonicalPath}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light; --ink: #17251d; --muted: #556258; --accent: #4e6b2b; --cream: #fbf8ee; --line: #d8dfcf; }
      * { box-sizing: border-box; }
      body { margin: 0; color: var(--ink); background: var(--cream); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.6; }
      a { color: #315c47; text-underline-offset: 0.16em; }
      .shell { max-width: 980px; margin: 0 auto; padding: 24px; }
      header { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 4px 0 38px; border-bottom: 1px solid var(--line); }
      .brand { display: inline-flex; align-items: center; gap: 11px; color: var(--ink); font-weight: 800; text-decoration: none; letter-spacing: -0.03em; }
      .mark { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: var(--accent); color: white; font-size: 17px; }
      nav { display: flex; flex-wrap: wrap; gap: 14px; font-size: 0.92rem; }
      nav a { color: var(--muted); text-decoration: none; }
      main { max-width: 760px; padding: 52px 0 58px; }
      .eyebrow { margin: 0 0 10px; color: var(--accent); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.14em; }
      h1 { margin: 0 0 18px; font-size: clamp(2.1rem, 6vw, 4rem); letter-spacing: -0.055em; line-height: 1.02; }
      h2 { margin-top: 38px; font-size: 1.28rem; letter-spacing: -0.02em; }
      p, li { color: #334037; }
      .lead { max-width: 650px; color: var(--muted); font-size: 1.14rem; }
      .panel { padding: 22px 24px; margin: 26px 0; border: 1px solid var(--line); border-radius: 16px; background: #fffef9; }
      .notice { border-left: 4px solid #d5913c; }
      footer { padding: 28px 0 8px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.88rem; }
      footer nav { margin-top: 10px; }
      code { padding: 0.12em 0.35em; border-radius: 4px; background: #eef1e8; }
      @media (max-width: 600px) { header { align-items: flex-start; flex-direction: column; } .shell { padding: 18px; } main { padding-top: 38px; } }
    </style>
  </head>
  <body>
    <div class="shell">
      <header>
        <a class="brand" href={`${base}/`}><span class="mark" aria-hidden="true">B</span><span>Brightbean</span></a>
        <nav aria-label="Seitennavigation">
          <a href={`${base}/`}>Über Brightbean</a>
          <a href={`${base}/privacy/`}>Datenschutz</a>
          <a href={`${base}/terms/`}>Nutzungsbedingungen</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer>
        <div>Brightbean · Selbst gehostete Social-Media-Verwaltung</div>
        <nav aria-label="Rechtliche Navigation">
          <a href={`${base}/privacy/`}>Datenschutz</a>
          <a href={`${base}/terms/`}>Nutzungsbedingungen</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
