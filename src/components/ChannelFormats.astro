---
import { CATEGORY_META } from '../config/site';
import { withBase } from '../utils/paths';
const channels = Object.values(CATEGORY_META);
---
<section class="channel-formats container section" aria-labelledby="formats-title"><div class="section-heading section-heading--split"><div><p class="eyebrow"><i></i> CHANNEL FORMAT</p><h2 id="formats-title">Built for the <span>scroll.</span></h2></div><p>Three content channels, one filter: relevance. Pick the signal type you want and jump into the matching editorial lane.</p></div><div class="format-grid">{channels.map((meta,index) => <a class={`format-card format-card--${meta.slug}`} href={`${withBase('topics/')}#${meta.slug}`}><div class="format-card__top"><span>0{index+1}</span><small>{meta.eyebrow}</small></div><h3>{meta.title}</h3><p>{meta.summary}</p><div class="format-signal" aria-hidden="true"><i></i><i></i><i></i></div><footer><b>FILTER</b><em>OPEN TOPIC ↗</em></footer></a>)}</div></section>
