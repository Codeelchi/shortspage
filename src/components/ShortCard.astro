---
import type { ShortEntry } from '../utils/shorts';
import { formatDate, getThumbnail } from '../utils/shorts';
import { shortUrl } from '../utils/paths';
interface Props { entry: ShortEntry; signal?: string; compact?: boolean; }
const { entry, signal = '001', compact = false } = Astro.props;
const { data } = entry;
const thumbnail = getThumbnail(entry);
---
<article class:list={['short-card', { 'short-card--compact': compact }]} data-short-card data-category={data.category} data-tags={data.tags.join('|').toLowerCase()} data-search={`${data.title} ${data.hook} ${data.tags.join(' ')}`.toLowerCase()}>
<a class="short-card__media" href={shortUrl(data.slug)} aria-label={`Open ${data.title}`}><img src={thumbnail} alt={`${data.title} thumbnail`} width="360" height="640" loading="lazy" decoding="async" /><span class="play-indicator" aria-hidden="true">▶</span><span class="signal-id">SIGNAL {signal}</span>{data.demo && <span class="demo-badge">DEMO SIGNAL</span>}{data.status && !data.demo && <span class="status-badge">{data.status}</span>}</a>
<div class="short-card__body"><div class="short-card__meta"><span>{data.category.toUpperCase()}</span><time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>{data.duration && <span>{data.duration}</span>}</div><h3><a href={shortUrl(data.slug)}>{data.title}</a></h3><p>{data.hook}</p><div class="tag-list" aria-label="Tags">{data.tags.slice(0,3).map((tag) => <span>#{tag.replaceAll(' ','')}</span>)}</div><div class="short-card__actions"><a href={shortUrl(data.slug)}>Context</a><a href={data.youtubeUrl} target="_blank" rel="noopener noreferrer">{data.demo ? 'Channel' : 'Watch'} ↗</a></div></div>
</article>
