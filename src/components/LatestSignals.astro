---
import type { ShortEntry } from '../utils/shorts';
import ShortCard from './ShortCard.astro';
import { signalNumber } from '../utils/shorts';
import { withBase } from '../utils/paths';
interface Props { entries: ShortEntry[]; }
const { entries } = Astro.props;
---
<section class="latest-signals container section" id="latest" aria-labelledby="latest-title"><div class="section-heading section-heading--split"><div><p class="eyebrow"><i></i> LATEST SIGNALS</p><h2 id="latest-title">The newest <span>Shorts.</span></h2></div><div class="section-heading__aside"><p>Fast scans of what changed, why it matters and what is actually worth trying next.</p><a class="text-link" href={withBase('shorts/')}>View all signals ↗</a></div></div><div class="short-grid short-grid--latest">{entries.map((entry,index) => <ShortCard entry={entry} signal={signalNumber(index)} />)}</div></section>
