---
const channel = 'https://www.youtube.com/@AiTechTrendsShort';
const shorts = `${channel}/shorts`;
const subscribe = `${channel}?sub_confirmation=1`;
const base = import.meta.env.BASE_URL;
const logo = `${base}logo.svg`;
const canonical = 'https://codeelchi.github.io/shortspage/';

const topics = [
  { number: '01', label: 'AI NEWS', title: 'What changed?', text: 'New models, releases and industry shifts — filtered down to the signal that actually matters.' },
  { number: '02', label: 'AI TOOLS', title: 'What is useful?', text: 'Apps, agents, automations and workflows with a clear focus on practical value.' },
  { number: '03', label: 'TECH TRENDS', title: 'What comes next?', text: 'Emerging technology, digital business and the ideas shaping tomorrow’s workflows.' },
];

const previews = [
  { type: 'news', eyebrow: 'BREAKING NEWS', title: 'AI NEWS', sub: 'UPDATES · TRENDS · INSIGHTS', meta: 'FAST SIGNAL' },
  { type: 'tools', eyebrow: 'TOP TOOLS', title: 'AI TOOLS', sub: 'APPS · AUTOMATION · WORKFLOWS', meta: 'SMART WORKFLOWS' },
  { type: 'trend', eyebrow: 'TECH RADAR', title: 'NEXT', sub: 'AI · SOFTWARE · DIGITAL BUSINESS', meta: 'WHAT TO WATCH' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="AI & Tech Trends — fast YouTube Shorts about AI news, useful tools, automation, workflows and emerging technology." />
  <meta name="theme-color" content="#020611" />
  <meta name="color-scheme" content="dark" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={logo} type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="AI & Tech Trends — Fast insights. Zero fluff." />
  <meta property="og:description" content="AI tools, tech trends and digital business — distilled into fast YouTube Shorts." />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://codeelchi.github.io/shortspage/logo.svg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="AI & Tech Trends" />
  <meta name="twitter:description" content="Fast insights. Zero fluff." />
  <meta name="twitter:image" content="https://codeelchi.github.io/shortspage/logo.svg" />
  <title>AI & Tech Trends — AI Tools, News & Tech Shorts</title>
</head>
<body>
  <div class="site-shell">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>

    <header class="nav-wrap">
      <a class="brand" href="#top" aria-label="AI and Tech Trends home">
        <img src={logo} alt="AI & Tech Trends" />
        <span><b>AI&TECH</b><em>TRENDS</em></span>
      </a>
      <nav aria-label="Main navigation"><a href="#shorts">Shorts</a><a href="#topics">Topics</a><a href="#about">About</a></nav>
      <a class="nav-cta" href={channel} target="_blank" rel="noreferrer">YouTube <span>↗</span></a>
    </header>

    <main id="top">
      <section class="hero section-pad">
        <div class="hero-copy">
          <p class="eyebrow"><i></i> AI TOOLS · TECH TRENDS · DIGITAL BUSINESS</p>
          <h1><span>AI&TECH</span><strong>TRENDS</strong></h1>
          <p class="tagline">Fast insights. <b>Zero fluff.</b></p>
          <p class="lead">Stay ahead of AI, automation and emerging technology with fast, focused Shorts built for people who want the signal — not the noise.</p>
          <div class="actions"><a class="button primary" href={shorts} target="_blank" rel="noreferrer">▶ Watch the Shorts</a><a class="button ghost" href={subscribe} target="_blank" rel="noreferrer">Subscribe ↗</a></div>
          <div class="microstats" aria-label="Channel themes"><span><b>AI</b><small>NEWS</small></span><span><b>TOOLS</b><small>WORKFLOWS</small></span><span><b>TECH</b><small>TRENDS</small></span></div>
        </div>
        <div class="hero-visual" aria-label="AI and Tech Trends visual identity">
          <div class="hud-card">
            <div class="corner tl"></div><div class="corner tr"></div><div class="corner bl"></div><div class="corner br"></div>
            <span class="hud-label top">AITT // SIGNAL ACTIVE</span><span class="hud-label bottom">SCAN · FILTER · WATCH</span>
            <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
            <div class="circuit c1"><i></i></div><div class="circuit c2"><i></i></div><div class="circuit c3"><i></i></div><div class="circuit c4"><i></i></div>
            <img src={logo} alt="AI & Tech Trends circular neon logo" />
          </div>
        </div>
      </section>

      <div class="ticker" aria-hidden="true"><div class="ticker-track"><span>BREAKING AI</span><b>◆</b><span>TOP TOOLS</span><b>◆</b><span>AUTOMATION</span><b>◆</b><span>TECH TRENDS</span><b>◆</b><span>DIGITAL BUSINESS</span><b>◆</b><span>BREAKING AI</span><b>◆</b><span>TOP TOOLS</span><b>◆</b></div></div>

      <section class="shorts-showcase section-pad" id="shorts">
        <div class="section-head split-head"><div><p class="eyebrow"><i></i> CHANNEL FORMAT</p><h2>Built for the <span>scroll.</span></h2></div><p>Bold visuals, fast context and practical takeaways — the same energy as the channel thumbnails, translated into a clean web experience.</p></div>
        <div class="preview-grid">
          {previews.map((preview) => (
            <a class={`preview-card ${preview.type}`} href={shorts} target="_blank" rel="noreferrer" aria-label={`Open ${preview.title} Shorts on YouTube`}>
              <div class="preview-logo"><img src={logo} alt="" /></div><small>{preview.eyebrow}</small><h3>{preview.title}</h3><p>{preview.sub}</p>
              <div class="preview-tech"><span></span><span></span><span></span></div><footer><b>{preview.meta}</b><em>WATCH ↗</em></footer>
            </a>
          ))}
        </div>
      </section>

      <section class="topics section-pad" id="topics">
        <div class="section-head"><p class="eyebrow"><i></i> CONTENT PILLARS</p><h2>The topics that <span>move fastest.</span></h2><p class="section-copy">Three lanes. One filter: relevance. Everything is designed to help you understand what changed, why it matters and what is worth trying.</p></div>
        <div class="topic-grid">
          {topics.map((topic) => (
            <article class="topic-card"><div class="topic-top"><span>{topic.number}</span><small>{topic.label}</small></div><div class="topic-icon"><i></i><i></i><i></i></div><h3>{topic.title}</h3><p>{topic.text}</p><div class="scanline"></div></article>
          ))}
        </div>
      </section>

      <section class="manifesto section-pad" id="about">
        <div class="manifesto-panel">
          <div class="manifesto-art" aria-hidden="true"><div class="chip"><span>AI</span></div><div class="node n1">NEWS</div><div class="node n2">TOOLS</div><div class="node n3">DATA</div><div class="node n4">AUTO</div></div>
          <div class="manifesto-copy"><p class="eyebrow"><i></i> THE IDEA</p><h2>Less hype.<br/><span>More signal.</span></h2><p>AI moves too fast for long introductions. AI&Tech Trends turns product launches, useful tools, automation ideas and technology shifts into short-form context you can act on.</p><ul><li><b>Fast</b><span>Quick enough for a break.</span></li><li><b>Focused</b><span>Built around one useful idea.</span></li><li><b>Practical</b><span>Tools and workflows you can explore.</span></li></ul></div>
        </div>
      </section>

      <section class="final-cta section-pad">
        <div class="cta-panel"><img src={logo} alt="AI & Tech Trends" /><div><p class="eyebrow"><i></i> FOLLOW THE SIGNAL</p><h2>Your next useful idea<br/>is one Short away.</h2><p>AI news. Better tools. Smarter workflows. Emerging tech.</p></div><a class="button primary big" href={subscribe} target="_blank" rel="noreferrer">▶ Subscribe on YouTube</a></div>
      </section>
    </main>

    <footer class="site-footer"><div class="footer-brand"><img src={logo} alt=""/><span>AI&TECH TRENDS</span></div><p>AI Tools · Tech Trends · Digital Business</p><a href={channel} target="_blank" rel="noreferrer">@AiTechTrendsShort ↗</a></footer>
  </div>
</body>
</html>
