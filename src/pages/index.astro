---
import '../styles.css';
import Home from '../components/Home.astro';
---
<Home />
<style is:global>
:root{--max:1400px}
.nav-wrap{height:82px;background:linear-gradient(180deg,rgba(2,8,20,.78),rgba(2,8,20,.2));backdrop-filter:blur(14px);padding-inline:6px}
.brand{gap:14px}.brand img{width:50px;height:50px;border-radius:50%;box-shadow:0 0 24px #13ceff2c}.brand b{font-size:14px;letter-spacing:.06em}.brand em{font-size:10px;letter-spacing:.14em}.nav-wrap nav{gap:32px;font-size:13px}.nav-cta{padding:10px 17px}
.hero{min-height:610px;grid-template-columns:1.03fr .97fr;gap:38px;padding-block:40px 34px;align-items:center}.hero-copy{max-width:700px;padding-right:0}.hero h1{line-height:.86}.hero h1 span{font-size:clamp(72px,6.8vw,108px)}.hero h1 strong{font-size:clamp(70px,6.6vw,104px);margin-top:12px}.tagline{margin-top:26px;font-size:clamp(22px,1.8vw,28px)}.lead{font-size:16.5px;max-width:620px;line-height:1.7}.actions{margin-top:26px}.button{min-height:50px}.microstats{margin-top:22px}.microstats span{min-width:108px;padding:10px 14px;background:linear-gradient(180deg,#07182eb8,#051021d9);border-color:#39b8ff26;box-shadow:inset 0 0 20px #0a78d70b}.microstats b{font-size:11px}.microstats small{font-size:7px}
.hero-visual{min-height:520px;align-items:center;position:relative}.hero-visual:before{content:"";position:absolute;width:78%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#0b78d328 0,rgba(7,45,93,.12) 42%,transparent 70%);filter:blur(12px);pointer-events:none}.hero-visual:after{content:"";position:absolute;width:78%;height:1px;background:linear-gradient(90deg,transparent,#35dfff4d,transparent);box-shadow:0 0 18px #20d7ff4d;pointer-events:none}
.hud-card{width:min(100%,540px);aspect-ratio:1;border:0;border-radius:50%;background:radial-gradient(circle at center,rgba(8,38,78,.34) 0,rgba(5,21,44,.16) 44%,transparent 72%),repeating-radial-gradient(circle at center,transparent 0 66px,rgba(46,202,255,.07) 67px 68px);box-shadow:none;overflow:visible}.hud-card img{display:block;width:78%;border-radius:50%;filter:drop-shadow(0 0 24px #18cfff58) drop-shadow(0 0 62px #0b75ff2c);position:relative;z-index:3}.hud-card:before{inset:3%;border:1px solid #2bd6ff2d;box-shadow:0 0 36px #14bfff14}.hud-card:after{inset:15%;border:1px dashed #36dfff24}.corner{display:none}.hud-label{font-size:8px;opacity:.78}.hud-label.top{top:8%;left:9%}.hud-label.bottom{bottom:8%;right:9%}.orbit-one{inset:7%;border-color:#2ed5ff24}.orbit-two{inset:20%;border-color:#2ed5ff1c}.circuit{opacity:.52}.c1{width:23%;left:-1%;top:31%}.c2{width:21%;right:-1%;top:38%}.c3{width:20%;left:0;bottom:29%}.c4{width:22%;right:0;bottom:35%}
.hero:before{content:"";position:absolute;left:-8%;right:-8%;bottom:0;height:1px;background:linear-gradient(90deg,transparent,#2bd6ff24,transparent)}
.shorts-showcase{padding-top:82px}.split-head{gap:54px}.preview-grid{margin-top:40px}
@media(min-width:1550px){:root{--max:1440px}.hero{gap:48px}.hud-card{width:min(100%,560px)}}
@media(max-width:1080px){.hero{grid-template-columns:1fr 1fr;gap:24px}.hud-card{width:min(100%,470px)}.hero h1 span{font-size:clamp(66px,8vw,96px)}.hero h1 strong{font-size:clamp(64px,7.7vw,92px)}}
@media(max-width:900px){.nav-wrap{height:76px}.hero{grid-template-columns:1fr;min-height:auto;padding-block:42px 44px;gap:30px}.hero-copy{max-width:none}.hero-visual{min-height:auto;order:-1}.hud-card{width:min(100%,420px)}.hero h1 span,.hero h1 strong{font-size:clamp(58px,12vw,92px)}.shorts-showcase{padding-top:72px}}
@media(max-width:620px){.nav-wrap{height:70px}.brand img{width:42px;height:42px}.hero{padding-block:30px 34px}.hero-visual{order:0}.hud-card{width:min(100%,360px)}.hud-label{display:none}.hero h1 span,.hero h1 strong{font-size:clamp(46px,14.5vw,68px)}.tagline{font-size:20px}.lead{font-size:15.5px}.microstats{gap:8px}.microstats span{min-width:92px;padding:9px 11px}}
</style>
