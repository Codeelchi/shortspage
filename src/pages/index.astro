---
import '../styles.css';
import Home from '../components/Home.astro';
---
<Home />
<style is:global>
:root{--max:1360px}
.nav-wrap{height:84px;background:linear-gradient(180deg,rgba(2,8,20,.74),rgba(2,8,20,.26));backdrop-filter:blur(12px);padding-inline:4px}
.brand img{width:52px;height:52px}.brand b{font-size:14px}.brand em{font-size:10px}
.hero{min-height:630px;grid-template-columns:1.08fr .92fr;gap:52px;padding-block:46px 42px}.hero-copy{padding-right:10px}.hero h1{line-height:.84}.hero h1 span{font-size:clamp(74px,7.2vw,118px)}.hero h1 strong{font-size:clamp(72px,7vw,112px);margin-top:18px}.tagline{margin-top:28px}.lead{font-size:17px;max-width:640px}
.hero-visual{align-items:center}.hud-card{width:min(100%,500px);border-radius:30px;background:url('/shortspage/logo.svg') center/64% no-repeat,radial-gradient(circle at center,#0a2551 0,#071a36 36%,#030915 74%);box-shadow:0 28px 80px #0009,inset 0 0 55px #068cff13,0 0 70px #079bff20}.hud-card img{display:none}.hud-card:before{inset:8%}.hud-card:after{inset:19%}.hud-label.top{top:22px;left:26px}.hud-label.bottom{bottom:22px;right:26px}.hero:before{content:"";position:absolute;left:-12%;right:-12%;bottom:0;height:1px;background:linear-gradient(90deg,transparent,#2bd6ff29,transparent)}
@media(min-width:1500px){:root{--max:1460px}.hero{min-height:660px;gap:70px}.hud-card{width:min(100%,540px)}}
@media(max-width:980px){.nav-wrap{height:78px}.hero{grid-template-columns:1fr;min-height:auto;padding-block:46px 48px;gap:38px}.hero-copy{padding-right:0}.hero-visual{order:-1}.hud-card{width:min(100%,440px)}.hero h1 span,.hero h1 strong{font-size:clamp(58px,12vw,96px)}}
@media(max-width:620px){.nav-wrap{height:72px}.brand img{width:44px;height:44px}.hero{padding-block:34px 38px}.hero-visual{order:0}.hud-card{width:100%;border-radius:22px}.hud-label.top{top:18px;left:18px}.hud-label.bottom{bottom:18px;right:18px}.hero h1 span,.hero h1 strong{font-size:clamp(48px,15vw,72px)}.tagline{font-size:21px}.lead{font-size:16px}}
</style>
