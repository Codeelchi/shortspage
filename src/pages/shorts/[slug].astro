---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShortCard from '../../components/ShortCard.astro';
import PrivacyPlayer from '../../components/PrivacyPlayer.astro';
import { SITE } from '../../config/site';
import { absoluteUrl, withBase } from '../../utils/paths';
import { durationToIso, formatDate, getThumbnail, signalNumber, sortShorts } from '../../utils/shorts';
export async function getStaticPaths(){const entries=await getCollection('shorts');return entries.map((entry)=>({params:{slug:entry.data.slug},props:{entry}}));}
interface Props { entry: CollectionEntry<'shorts'> }
const { entry }=Astro.props;const { Content }=await render(entry);const all=sortShorts(await getCollection('shorts'));const related=all.filter((item)=>item.data.slug!==entry.data.slug&&item.data.category===entry.data.category).slice(0,3);const thumbnail=getThumbnail(entry);const absoluteThumbnail=getThumbnail(entry,true);const canonicalPath=`shorts/${entry.data.slug}/`;
const videoStructuredData=entry.data.demo?undefined:{'@context':'https://schema.org','@type':'VideoObject',name:entry.data.title,description:entry.data.description,thumbnailUrl:[absoluteThumbnail],uploadDate:entry.data.publishedAt.toISOString(),duration:durationToIso(entry.data.duration),contentUrl:entry.data.youtubeUrl,embedUrl:`https://www.youtube-nocookie.com/embed/${entry.data.youtubeId}`};
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:SITE.name,item:absoluteUrl('')},{'@type':'ListItem',position:2,name:'Shorts',item:absoluteUrl('shorts/')},{'@type':'ListItem',position:3,name:entry.data.title,item:absoluteUrl(canonicalPath)}]};const structuredData=videoStructuredData?[videoStructuredData,breadcrumb]:[breadcrumb];
---
<BaseLayout title={`${entry.data.title} — ${SITE.name}`} description={entry.data.description} canonicalPath={canonicalPath} type="article" noindex={entry.data.demo} structuredData={structuredData}>
<article class="signal-detail container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={withBase('')}>Home</a><span>/</span><a href={withBase('shorts/')}>Shorts</a><span>/</span><span aria-current="page">Signal</span></nav><div class="signal-detail__grid"><div class="signal-detail__media">{entry.data.demo?<div class="demo-player"><img src={thumbnail} alt={`${entry.data.title} demo thumbnail`} width="360" height="640" /><p>DEMO SIGNAL · No video is embedded for sample content.</p></div>:<PrivacyPlayer youtubeId={entry.data.youtubeId} title={entry.data.title} thumbnail={thumbnail} />}</div><div class="signal-detail__copy"><div class="signal-kicker"><span>{entry.data.category.toUpperCase()}</span>{entry.data.demo&&<span>DEMO SIGNAL</span>}</div><h1>{entry.data.title}</h1><p class="signal-hook">{entry.data.hook}</p><div class="signal-detail__meta"><time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time>{entry.data.duration&&<span>{entry.data.duration}</span>}</div><div class="tag-list tag-list--large">{entry.data.tags.map((tag)=><span>#{tag.replaceAll(' ','')}</span>)}</div><a class="button primary" href={entry.data.youtubeUrl} target="_blank" rel="noreferrer">▶ {entry.data.demo?'Open channel on YouTube':'Watch on YouTube'}</a></div></div><div class="signal-context"><p class="eyebrow"><i></i> SIGNAL CONTEXT</p><div class="prose"><Content /></div></div>{entry.data.sources.length>0&&<section class="sources" aria-labelledby="sources-title"><h2 id="sources-title">Sources</h2><ul>{entry.data.sources.map((source)=><li><a href={source.url} target="_blank" rel="noreferrer">{source.name} ↗</a></li>)}</ul></section>}</article>
{related.length>0&&<section class="related-signals container section" aria-labelledby="related-title"><div class="section-heading"><p class="eyebrow"><i></i> RELATED SIGNALS</p><h2 id="related-title">Keep <span>scanning.</span></h2></div><div class="short-grid short-grid--related">{related.map((item,index)=><ShortCard entry={item} signal={signalNumber(index)} compact />)}</div></section>}
</BaseLayout>
