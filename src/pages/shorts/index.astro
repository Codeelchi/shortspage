---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedShort from '../../components/FeaturedShort.astro';
import ShortCard from '../../components/ShortCard.astro';
import SignalTicker from '../../components/SignalTicker.astro';
import { CATEGORY_META } from '../../config/site';
import { signalNumber, sortShorts } from '../../utils/shorts';
const entries = sortShorts(await getCollection('shorts'));
const featured = entries.find((entry) => entry.data.featured) ?? entries[0];
const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))].sort((a,b) => a.localeCompare(b));
---
<BaseLayout title="Shorts — AI&TECH TRENDS" description="Browse AI&TECH TRENDS Shorts by AI News, AI Tools and Tech Trends. Fast signal, useful context and a direct handoff to YouTube." canonicalPath="shorts/">
<section class="page-hero container"><p class="eyebrow"><i></i> SIGNAL LIBRARY</p><h1>All <span>Shorts.</span></h1><p>Scan the latest signals, filter by topic and jump to YouTube when you are ready to watch.</p></section><SignalTicker />{featured && <FeaturedShort entry={featured} />}
<section class="shorts-library container section" aria-labelledby="all-signals-title"><div class="section-heading section-heading--split"><div><p class="eyebrow"><i></i> SCAN · FILTER · WATCH</p><h2 id="all-signals-title">All <span>signals.</span></h2></div><p>Everything is statically generated. Filters run locally in the browser and do not require an API or framework.</p></div>
<div class="filter-panel" id="filters" data-short-filters><div class="filter-group" aria-label="Filter by category"><a href="?" class="filter-chip is-active" data-category-filter="all" aria-pressed="true">All</a>{Object.keys(CATEGORY_META).map((category) => <a href={`?category=${encodeURIComponent(category)}`} class="filter-chip" data-category-filter={category} aria-pressed="false">{category}</a>)}</div><label class="search-field"><span>Search signals</span><input type="search" placeholder="Models, agents, automation…" data-search-input autocomplete="off" /></label><label class="tag-select"><span>Tag</span><select data-tag-filter><option value="all">All tags</option>{tags.map((tag) => <option value={tag.toLowerCase()}>{tag}</option>)}</select></label><p class="filter-count" aria-live="polite"><b data-visible-count>{entries.length}</b> signals visible</p></div>
<div class="short-grid short-grid--library" data-shorts-grid>{entries.map((entry,index) => <ShortCard entry={entry} signal={signalNumber(index)} />)}</div><p class="empty-state" data-empty-state hidden>No signals match this filter. Try a broader scan.</p></section>
</BaseLayout>
<script>
const panel=document.querySelector<HTMLElement>('[data-short-filters]');const cards=[...document.querySelectorAll<HTMLElement>('[data-short-card]')];const categoryLinks=[...document.querySelectorAll<HTMLAnchorElement>('[data-category-filter]')];const searchInput=document.querySelector<HTMLInputElement>('[data-search-input]');const tagSelect=document.querySelector<HTMLSelectElement>('[data-tag-filter]');const count=document.querySelector<HTMLElement>('[data-visible-count]');const empty=document.querySelector<HTMLElement>('[data-empty-state]');
if(panel&&cards.length){const params=new URLSearchParams(window.location.search);let category=params.get('category')??'all';let query=params.get('q')?.toLowerCase()??'';let tag=params.get('tag')?.toLowerCase()??'all';const apply=()=>{let visible=0;cards.forEach((card)=>{const categoryMatch=category==='all'||card.dataset.category===category;const tagMatch=tag==='all'||(card.dataset.tags??'').split('|').includes(tag);const queryMatch=!query||(card.dataset.search??'').includes(query);const show=categoryMatch&&tagMatch&&queryMatch;card.hidden=!show;if(show)visible+=1;});if(count)count.textContent=String(visible);if(empty)empty.hidden=visible!==0;categoryLinks.forEach((link)=>{const active=link.dataset.categoryFilter===category;link.classList.toggle('is-active',active);link.setAttribute('aria-pressed',String(active));});const next=new URLSearchParams();if(category!=='all')next.set('category',category);if(query)next.set('q',query);if(tag!=='all')next.set('tag',tag);const suffix=next.toString();history.replaceState(null,'',`${window.location.pathname}${suffix?`?${suffix}`:''}${window.location.hash}`);};categoryLinks.forEach((link)=>link.addEventListener('click',(event)=>{event.preventDefault();category=link.dataset.categoryFilter??'all';apply();}));if(searchInput){searchInput.value=params.get('q')??'';searchInput.addEventListener('input',()=>{query=searchInput.value.trim().toLowerCase();apply();});}if(tagSelect){tagSelect.value=tag;tagSelect.addEventListener('change',()=>{tag=tagSelect.value;apply();});}apply();}
</script>
